{
  "name": "backoffice-user-management",
  "version": "1.0.0",
  "private": true,
  "description": "Back-office User and Session Management System",
  "engines": {
    "node": ">=26.0.0"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "prepare": "husky || true",
    "lint": "eslint .",
    "dev:backend": "npm --workspace=backend run start:dev",
    "dev:frontend": "npm --workspace=frontend run dev",
    "build": "npm --workspace=backend run build && npm --workspace=frontend run build",
    "test:backend": "npm --workspace=backend run test",
    "test:backend:cov": "npm --workspace=backend run test:cov",
    "test:frontend": "npm --workspace=frontend run test",
    "test:frontend:cov": "npm --workspace=backend run test:cov",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down -v",
    "docs:backend": "npm --workspace=backend run docs",
    "docs:frontend": "npm --workspace=frontend run docs",
    "docs": "npm run docs:backend && npm run docs:frontend"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "eslint": "^10.15.0",
    "husky": "^9.1.7",
    "typescript-eslint": "^8.73.0"
  }
}
