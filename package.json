{
    "name": "backoffice-user-management",
    "version": "1.0.0",
    "private": true,
    "description": "Back-office User and Session Management System",
    "engines": {
      "node": ">=26.0.0"
    },
    "workspaces": [
      "backend",
      "frontend"
    ],
    "scripts": {
      "dev:backend": "npm --workspace=backend run start:dev",
      "dev:frontend": "npm --workspace=frontend run dev",
      "build": "npm --workspace=backend run build && npm --workspace=frontend run build",
      "test:backend": "npm --workspace=backend run test",
      "test:e2e": "npm --workspace=frontend run test:e2e"
    }
  }
  